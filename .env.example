# OpenPanel Go does NOT read credentials from .env at runtime: you paste them
# into the app, and the secret goes straight to the iOS Keychain / Android
# Keystore. This file documents the values you need and can feed the
# optional debug prefill below.
#
# Usage (debug only):
#   flutter run --dart-define-from-file=.env
# Never commit a real .env.

# Cloud: https://api.openpanel.dev  ·  Self-hosted: https://api.yourdomain.com
OP_BASE_URL=https://api.openpanel.dev

# Dashboard → your project → the id in the URL (dashboard.openpanel.dev/<org>/<projectId>)
OP_PROJECT_ID=

# Must be a READ (or ROOT) client. The default WRITE client gets 401.
# Project Settings → Clients → Create client → Mode: Read
OP_CLIENT_ID=
OP_CLIENT_SECRET=

OP_PROJECT_NAME=My website
